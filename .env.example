# Veritrack environment.
#
# Copy to `.env.local` and fill in. With NEXT_PUBLIC_USE_EMULATOR=true the app
# talks only to the local Firebase emulators and the values below are ignored
# apart from the project id, so the placeholder values are enough for development.
#
# To point at a REAL Firebase project:
#   1. Firebase console -> Project settings -> "Your apps" -> Web app -> Config.
#   2. Paste the six values below into `.env.local`.
#   3. Set NEXT_PUBLIC_USE_EMULATOR=false.
#   4. Enable Authentication -> Sign-in method -> Google and Email/Password.
#   5. Deploy rules and indexes: `firebase deploy --only firestore`.

# Web API key from the Firebase console. Public by design; access is controlled
# by security rules, not by hiding this.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key

# <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-veritrack.firebaseapp.com

# Must match .firebaserc. A "demo-" prefix keeps the emulator fully offline.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-veritrack

# <project-id>.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-veritrack.appspot.com

# Cloud Messaging sender id.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Web app id, looks like 1:000000000000:web:abc123.
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demoveritrack

# "true" routes Auth to 127.0.0.1:9099 and Firestore to 127.0.0.1:8080.
NEXT_PUBLIC_USE_EMULATOR=true
